{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.fieldcure/rag",
  "description": "MCP RAG server with hybrid search, multi-KB support, and AI-powered chunk contextualization.",
  "version": "2.5.0",
  "repository": {
    "url": "https://github.com/fieldcure/fieldcure-mcp-rag",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "nuget",
      "registryBaseUrl": "https://api.nuget.org/v3/index.json",
      "identifier": "FieldCure.Mcp.Rag",
      "version": "2.5.0",
      "runtimeHint": "dnx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "OPENAI_API_KEY",
          "value": "{openai_api_key}",
          "variables": {
            "openai_api_key": {
              "description": "OpenAI API key for embeddings or contextualization",
              "isRequired": false,
              "isSecret": true
            }
          }
        },
        {
          "name": "ANTHROPIC_API_KEY",
          "value": "{anthropic_api_key}",
          "variables": {
            "anthropic_api_key": {
              "description": "Anthropic API key for contextualization",
              "isRequired": false,
              "isSecret": true
            }
          }
        },
        {
          "name": "GEMINI_API_KEY",
          "value": "{gemini_api_key}",
          "variables": {
            "gemini_api_key": {
              "description": "Gemini API key for embeddings or contextualization",
              "isRequired": false,
              "isSecret": true
            }
          }
        },
        {
          "name": "VOYAGE_API_KEY",
          "value": "{voyage_api_key}",
          "variables": {
            "voyage_api_key": {
              "description": "Voyage API key for configured providers",
              "isRequired": false,
              "isSecret": true
            }
          }
        },
        {
          "name": "GROQ_API_KEY",
          "value": "{groq_api_key}",
          "variables": {
            "groq_api_key": {
              "description": "Groq API key for configured providers",
              "isRequired": false,
              "isSecret": true
            }
          }
        }
      ]
    }
  ]
}
